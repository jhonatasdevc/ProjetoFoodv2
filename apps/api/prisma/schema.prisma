// Espelha o schema definido em /sql/init/001_schema.sql (fonte de verdade).
// Se alterar as tabelas, atualize os dois arquivos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Imagem {
  id       Int      @id @default(autoincrement())
  dados    Bytes
  tipo     String   @db.VarChar(100)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("imagem")
}

model Grupo {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(80)
  ordem    Int      @default(0)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")
  lojas    Loja[]

  @@map("grupo")
}

model Admin {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(160)
  senhaHash String   @map("senha_hash") @db.VarChar(200)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("admin")
}

model Loja {
  id              Int         @id @default(autoincrement())
  idGrupo         Int         @map("id_grupo")
  nome            String      @db.VarChar(120)
  arroba          String      @unique @db.VarChar(30)
  email           String      @unique @db.VarChar(160)
  senhaHash       String      @map("senha_hash") @db.VarChar(200)
  telefone        String?     @db.VarChar(20)
  endereco        String?     @db.VarChar(200)
  imagemUrl       String?     @map("imagem_url") @db.VarChar(300)
  imagemPerfilUrl String?     @map("imagem_perfil_url") @db.VarChar(300)
  aceitaEntrega   Boolean     @default(true) @map("aceita_entrega")
  tipoFrete       String      @default("pago") @map("tipo_frete") @db.VarChar(20)
  valorFrete      Decimal?    @map("valor_frete") @db.Decimal(10, 2)
  aceitaRetirada  Boolean     @default(false) @map("aceita_retirada")
  ativo           Boolean     @default(false)
  criadoEm        DateTime    @default(now()) @map("criado_em")
  grupo      Grupo       @relation(fields: [idGrupo], references: [id])
  categorias Categoria[]
  pedidos    Pedido[]
  stories    Story[]
  favoritos  Favorito[]
  horarios   HorarioFuncionamento[]
  fechamentos FechamentoTemporario[]

  @@map("loja")
}

model HorarioFuncionamento {
  id         Int      @id @default(autoincrement())
  idLoja     Int      @map("id_loja")
  diaSemana  Int      @map("dia_semana")
  abreEm     String?  @map("abre_em") @db.VarChar(5)
  fechaEm    String?  @map("fecha_em") @db.VarChar(5)
  fechado    Boolean  @default(false)
  loja       Loja     @relation(fields: [idLoja], references: [id], onDelete: Cascade)

  @@unique([idLoja, diaSemana])
  @@map("horario_funcionamento")
}

model FechamentoTemporario {
  id        Int      @id @default(autoincrement())
  idLoja    Int      @map("id_loja")
  inicio    DateTime
  fim       DateTime
  motivo    String?  @db.VarChar(200)
  criadoEm  DateTime @default(now()) @map("criado_em")
  loja      Loja     @relation(fields: [idLoja], references: [id], onDelete: Cascade)

  @@map("fechamento_temporario")
}

model Story {
  id        Int      @id @default(autoincrement())
  idLoja    Int      @map("id_loja")
  imagemUrl String   @map("imagem_url") @db.VarChar(300)
  criadoEm  DateTime @default(now()) @map("criado_em")
  loja      Loja     @relation(fields: [idLoja], references: [id], onDelete: Cascade)

  @@map("story")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nome      String     @db.VarChar(80)
  sobrenome String     @db.VarChar(80)
  telefone  String     @unique @db.VarChar(20)
  criadoEm  DateTime   @default(now()) @map("criado_em")
  enderecos Endereco[]
  pedidos   Pedido[]
  favoritos Favorito[]
  pushSubscriptions PushSubscription[]

  @@map("usuario")
}

model Endereco {
  id          Int      @id @default(autoincrement())
  idUsuario   Int      @map("id_usuario")
  cep         String   @db.VarChar(10)
  cidade      String   @db.VarChar(80)
  estado      String   @db.VarChar(2)
  rua         String   @db.VarChar(160)
  numero      String   @db.VarChar(20)
  complemento String?  @db.VarChar(80)
  referencia  String?  @db.VarChar(160)
  padrao      Boolean  @default(false)
  criadoEm    DateTime @default(now()) @map("criado_em")
  usuario     Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  pedidos     Pedido[]

  @@map("endereco")
}

model Favorito {
  id        Int      @id @default(autoincrement())
  idUsuario Int      @map("id_usuario")
  idLoja    Int      @map("id_loja")
  criadoEm  DateTime @default(now()) @map("criado_em")
  usuario   Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  loja      Loja     @relation(fields: [idLoja], references: [id], onDelete: Cascade)

  @@unique([idUsuario, idLoja])
  @@map("favorito")
}

model PushSubscription {
  id          Int      @id @default(autoincrement())
  idUsuario   Int      @map("id_usuario")
  endpoint    String   @unique
  chaveP256dh String   @map("chave_p256dh") @db.VarChar(200)
  chaveAuth   String   @map("chave_auth") @db.VarChar(200)
  criadoEm    DateTime @default(now()) @map("criado_em")
  usuario     Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@map("push_subscription")
}

model OtpCodigo {
  id       Int      @id @default(autoincrement())
  telefone String   @db.VarChar(20)
  codigo   String   @db.VarChar(6)
  expiraEm DateTime @map("expira_em")
  usado    Boolean  @default(false)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("otp_codigo")
  @@index([telefone])
}

model Cupom {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique @db.VarChar(30)
  tipoDesconto  String    @map("tipo_desconto") @db.VarChar(20)
  valorDesconto Decimal   @map("valor_desconto") @db.Decimal(10, 2)
  ativo         Boolean   @default(true)
  validoAte     DateTime? @map("valido_ate")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  pedidos       Pedido[]

  @@map("cupom")
}

model Categoria {
  id       Int      @id @default(autoincrement())
  idLoja   Int      @map("id_loja")
  nome     String   @db.VarChar(120)
  ordem    Int      @default(0)
  criadoEm DateTime @default(now()) @map("criado_em")
  loja     Loja     @relation(fields: [idLoja], references: [id], onDelete: Cascade)
  itens    Item[]

  @@map("categoria")
}

model Item {
  id                Int               @id @default(autoincrement())
  idCategoria       Int               @map("id_categoria")
  nome              String            @db.VarChar(120)
  descricao         String?
  preco             Decimal           @db.Decimal(10, 2)
  precoPromocional  Decimal?          @map("preco_promocional") @db.Decimal(10, 2)
  imagemUrl         String?           @map("imagem_url") @db.VarChar(300)
  disponivel        Boolean           @default(true)
  destaque          Boolean           @default(false)
  ordem             Int               @default(0)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  categoria    Categoria         @relation(fields: [idCategoria], references: [id], onDelete: Cascade)
  complementos ItemComplemento[]
  pedidoItens  PedidoItem[]

  @@map("item")
}

model ItemComplemento {
  id              Int          @id @default(autoincrement())
  idItem          Int          @map("id_item")
  nome            String       @db.VarChar(120)
  precoAdicional  Decimal      @default(0) @map("preco_adicional") @db.Decimal(10, 2)
  disponivel      Boolean      @default(true)
  item            Item         @relation(fields: [idItem], references: [id], onDelete: Cascade)
  pedidoItemComps PedidoItemComplemento[]

  @@map("item_complemento")
}

model Pedido {
  id               Int          @id @default(autoincrement())
  idLoja           Int          @map("id_loja")
  idUsuario        Int          @map("id_usuario")
  idEndereco       Int?         @map("id_endereco")
  idCupom          Int?         @map("id_cupom")
  clienteNome      String       @map("cliente_nome") @db.VarChar(120)
  clienteTelefone  String       @map("cliente_telefone") @db.VarChar(20)
  enderecoTexto    String       @map("endereco_texto")
  formaPagamento   String       @map("forma_pagamento") @db.VarChar(30)
  status           String       @default("recebido") @db.VarChar(20)
  total            Decimal      @default(0) @db.Decimal(10, 2)
  valorDesconto    Decimal      @default(0) @map("valor_desconto") @db.Decimal(10, 2)
  valorFrete       Decimal      @default(0) @map("valor_frete") @db.Decimal(10, 2)
  tipoEntrega      String       @default("entrega") @map("tipo_entrega") @db.VarChar(20)
  observacoes      String?
  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @default(now()) @map("atualizado_em")
  loja             Loja         @relation(fields: [idLoja], references: [id])
  usuario          Usuario      @relation(fields: [idUsuario], references: [id])
  endereco         Endereco?    @relation(fields: [idEndereco], references: [id], onDelete: SetNull)
  cupom            Cupom?       @relation(fields: [idCupom], references: [id], onDelete: SetNull)
  itens            PedidoItem[]
  statusHistorico  PedidoStatusHistorico[]
  mensagens        PedidoMensagem[]

  @@map("pedido")
}

model PedidoItem {
  id             Int                      @id @default(autoincrement())
  idPedido       Int                      @map("id_pedido")
  idItem         Int                      @map("id_item")
  quantidade     Int                      @default(1)
  precoUnitario  Decimal                  @map("preco_unitario") @db.Decimal(10, 2)
  observacao     String?                  @db.VarChar(300)
  pedido         Pedido                   @relation(fields: [idPedido], references: [id], onDelete: Cascade)
  item           Item                     @relation(fields: [idItem], references: [id])
  complementos   PedidoItemComplemento[]

  @@map("pedido_item")
}

model PedidoItemComplemento {
  id                 Int              @id @default(autoincrement())
  idPedidoItem       Int              @map("id_pedido_item")
  idItemComplemento  Int              @map("id_item_complemento")
  precoAdicional     Decimal          @default(0) @map("preco_adicional") @db.Decimal(10, 2)
  pedidoItem         PedidoItem       @relation(fields: [idPedidoItem], references: [id], onDelete: Cascade)
  itemComplemento    ItemComplemento  @relation(fields: [idItemComplemento], references: [id])

  @@map("pedido_item_complemento")
}

model PedidoStatusHistorico {
  id        Int      @id @default(autoincrement())
  idPedido  Int      @map("id_pedido")
  status    String   @db.VarChar(20)
  criadoEm  DateTime @default(now()) @map("criado_em")
  pedido    Pedido   @relation(fields: [idPedido], references: [id], onDelete: Cascade)

  @@map("pedido_status_historico")
}

model PedidoMensagem {
  id        Int      @id @default(autoincrement())
  idPedido  Int      @map("id_pedido")
  remetente String   @db.VarChar(10)
  texto     String
  criadoEm  DateTime @default(now()) @map("criado_em")
  pedido    Pedido   @relation(fields: [idPedido], references: [id], onDelete: Cascade)

  @@map("pedido_mensagem")
}
