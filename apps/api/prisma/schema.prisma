// Espelha o schema definido em /sql/init/001_schema.sql (fonte de verdade).
// Se alterar as tabelas, atualize os dois arquivos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Loja {
  id         Int         @id @default(autoincrement())
  nome       String      @db.VarChar(120)
  email      String      @unique @db.VarChar(160)
  senhaHash  String      @map("senha_hash") @db.VarChar(200)
  telefone   String?     @db.VarChar(20)
  endereco   String?     @db.VarChar(200)
  ativo      Boolean     @default(true)
  criadoEm   DateTime    @default(now()) @map("criado_em")
  categorias Categoria[]
  pedidos    Pedido[]

  @@map("loja")
}

model Categoria {
  id       Int      @id @default(autoincrement())
  idLoja   Int      @map("id_loja")
  nome     String   @db.VarChar(120)
  ordem    Int      @default(0)
  criadoEm DateTime @default(now()) @map("criado_em")
  loja     Loja     @relation(fields: [idLoja], references: [id], onDelete: Cascade)
  itens    Item[]

  @@map("categoria")
}

model Item {
  id           Int               @id @default(autoincrement())
  idCategoria  Int               @map("id_categoria")
  nome         String            @db.VarChar(120)
  descricao    String?
  preco        Decimal           @db.Decimal(10, 2)
  imagemUrl    String?           @map("imagem_url") @db.VarChar(300)
  disponivel   Boolean           @default(true)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  categoria    Categoria         @relation(fields: [idCategoria], references: [id], onDelete: Cascade)
  complementos ItemComplemento[]
  pedidoItens  PedidoItem[]

  @@map("item")
}

model ItemComplemento {
  id              Int          @id @default(autoincrement())
  idItem          Int          @map("id_item")
  nome            String       @db.VarChar(120)
  precoAdicional  Decimal      @default(0) @map("preco_adicional") @db.Decimal(10, 2)
  disponivel      Boolean      @default(true)
  item            Item         @relation(fields: [idItem], references: [id], onDelete: Cascade)
  pedidoItemComps PedidoItemComplemento[]

  @@map("item_complemento")
}

model Pedido {
  id               Int          @id @default(autoincrement())
  idLoja           Int          @map("id_loja")
  clienteNome      String       @map("cliente_nome") @db.VarChar(120)
  clienteTelefone  String       @map("cliente_telefone") @db.VarChar(20)
  enderecoTexto    String       @map("endereco_texto")
  formaPagamento   String       @map("forma_pagamento") @db.VarChar(30)
  status           String       @default("recebido") @db.VarChar(20)
  total            Decimal      @default(0) @db.Decimal(10, 2)
  observacoes      String?
  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @default(now()) @map("atualizado_em")
  loja             Loja         @relation(fields: [idLoja], references: [id])
  itens            PedidoItem[]
  statusHistorico  PedidoStatusHistorico[]

  @@map("pedido")
}

model PedidoItem {
  id             Int                      @id @default(autoincrement())
  idPedido       Int                      @map("id_pedido")
  idItem         Int                      @map("id_item")
  quantidade     Int                      @default(1)
  precoUnitario  Decimal                  @map("preco_unitario") @db.Decimal(10, 2)
  observacao     String?                  @db.VarChar(300)
  pedido         Pedido                   @relation(fields: [idPedido], references: [id], onDelete: Cascade)
  item           Item                     @relation(fields: [idItem], references: [id])
  complementos   PedidoItemComplemento[]

  @@map("pedido_item")
}

model PedidoItemComplemento {
  id                 Int              @id @default(autoincrement())
  idPedidoItem       Int              @map("id_pedido_item")
  idItemComplemento  Int              @map("id_item_complemento")
  precoAdicional     Decimal          @default(0) @map("preco_adicional") @db.Decimal(10, 2)
  pedidoItem         PedidoItem       @relation(fields: [idPedidoItem], references: [id], onDelete: Cascade)
  itemComplemento    ItemComplemento  @relation(fields: [idItemComplemento], references: [id])

  @@map("pedido_item_complemento")
}

model PedidoStatusHistorico {
  id        Int      @id @default(autoincrement())
  idPedido  Int      @map("id_pedido")
  status    String   @db.VarChar(20)
  criadoEm  DateTime @default(now()) @map("criado_em")
  pedido    Pedido   @relation(fields: [idPedido], references: [id], onDelete: Cascade)

  @@map("pedido_status_historico")
}
